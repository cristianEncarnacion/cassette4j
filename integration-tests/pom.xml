<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Not published: checks cassette4j with the real client libraries of each provider. -->
    <groupId>io.github.cristianencarnacion.it</groupId>
    <artifactId>cassette4j-integration-tests</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>
    <name>cassette4j integration tests</name>

    <modules>
        <module>fake-providers</module>
        <module>langchain4j</module>
        <module>spring-ai</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cassette4j.version>0.2.0</cassette4j.version>
        <langchain4j.version>1.23.0</langchain4j.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.11.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.cristianencarnacion</groupId>
                <artifactId>cassette4j-core</artifactId>
                <version>${cassette4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cristianencarnacion.it</groupId>
                <artifactId>fake-providers</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <trimStackTrace>false</trimStackTrace>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
